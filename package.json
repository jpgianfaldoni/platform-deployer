{
  "name": "oneclick-databricks-deployer-pwa",
  "version": "1.0.0",
  "description": "Progressive Web App for generating Terraform configurations for Databricks",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:headed": "playwright test --headed",
    "test:coverage": "playwright test --config=playwright.coverage.config.js && node scripts/collect-coverage.js",
    "coverage": "npm run test:coverage",
    "build:libs": "node scripts/copy-libs.js",
    "postinstall": "npm run build:libs"
  },
  "keywords": [
    "pwa",
    "databricks",
    "terraform",
    "progressive-web-app"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "v8-to-istanbul": "^9.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bootstrap": "5.3.2",
    "bootstrap-icons": "1.11.1",
    "choices.js": "^10.2.0",
    "jszip": "3.10.1",
    "playwright": "^1.57.0"
  }
}
