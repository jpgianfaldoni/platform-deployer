# ============================================================================
# Terraform Variables File (terraform.tfvars)
# ============================================================================
#
# PURPOSE:
#   This file provides default values for all variables.
#
# ============================================================================

# ----------------------------------------------------------------------------
# BASIC CONFIGURATION
# ----------------------------------------------------------------------------

region              = "{{region}}"
project_prefix      = "{{project_prefix}}"
resource_group_name = "{{resource_group_name}}"

# ----------------------------------------------------------------------------
# VNET CONFIGURATION
# ----------------------------------------------------------------------------

vnet_cidr       = "{{vpc_cidr}}"
create_new_vnet = {{create_new_vpc}}
{{#unless create_new_vpc}}
# Existing VNet Configuration
existing_vnet_id              = "{{existing_vnet_id}}"
existing_public_subnet_name   = "{{existing_public_subnet_name}}"
existing_private_subnet_name  = "{{existing_private_subnet_name}}"
{{/unless}}

# Subnet CIDRs
{{#each calculated_subnets}}
{{name_replace}}_subnet_cidr = "{{cidr}}"
{{/each}}

# ----------------------------------------------------------------------------
# DATABRICKS CONFIGURATION
# ----------------------------------------------------------------------------

pricing_tier   = "{{pricing_tier_lower}}"
workspace_name = "{{project_prefix}}"

# ----------------------------------------------------------------------------
# SECURITY CONFIGURATION
# ----------------------------------------------------------------------------

enable_private_link = {{enable_private_link}}

# ----------------------------------------------------------------------------
# TAGS
# ----------------------------------------------------------------------------

common_tags = {
  Project     = "{{project_prefix}}"
  Environment = "dev"
  ManagedBy   = "terraform"
  Provider    = "azure"
  CreatedBy   = "oneclick-databricks-deployer"
}
