# ============================================================================
# Azure Main Terraform Configuration
# ============================================================================
# Deploys Databricks workspace on Azure with VNet, NSG, and subnets.
# ============================================================================

# ----------------------------------------------------------------------------
# RESOURCE GROUP
# ----------------------------------------------------------------------------

# Container for all Azure resources
resource "azurerm_resource_group" "this" {
  name     = var.resource_group_name
  location = var.region
  
  tags = var.common_tags
}

# ----------------------------------------------------------------------------
# VIRTUAL NETWORK
# ----------------------------------------------------------------------------

# VNet for Databricks resources
resource "azurerm_virtual_network" "this" {
  count = var.create_new_vnet ? 1 : 0
  
  name                = "${var.project_prefix}-vnet"
  location            = azurerm_resource_group.this.location
  resource_group_name = azurerm_resource_group.this.name
  address_space       = [var.vnet_cidr]
  
  tags = var.common_tags
}

locals {
  # VNet ID (new or existing)
  vnet_id = var.create_new_vnet ? azurerm_virtual_network.this[0].id : var.existing_vnet_id
}

# ----------------------------------------------------------------------------
# NETWORK SECURITY GROUP
# ----------------------------------------------------------------------------

# NSG for Databricks subnets (rules managed by Azure)
resource "azurerm_network_security_group" "databricks" {
  count = var.create_new_vnet ? 1 : 0
  
  name                = "${var.project_prefix}-databricks-nsg"
  location            = azurerm_resource_group.this.location
  resource_group_name = azurerm_resource_group.this.name
  
  tags = var.common_tags
}

# ----------------------------------------------------------------------------
# SUBNETS
# ----------------------------------------------------------------------------

# Public (host) subnet for Databricks driver nodes
resource "azurerm_subnet" "public" {
  count = var.create_new_vnet ? 1 : 0
  
  name                 = "${var.project_prefix}-public-subnet"
  resource_group_name  = azurerm_resource_group.this.name
  virtual_network_name = azurerm_virtual_network.this[0].name
  address_prefixes     = [var.{{first_public_subnet_var}}_subnet_cidr]
  
  # Required delegation for Databricks
  delegation {
    name = "databricks-del-public"
    
    service_delegation {
      name = "Microsoft.Databricks/workspaces"
      actions = [
        "Microsoft.Network/virtualNetworks/subnets/join/action",
        "Microsoft.Network/virtualNetworks/subnets/prepareNetworkPolicies/action",
        "Microsoft.Network/virtualNetworks/subnets/unprepareNetworkPolicies/action"
      ]
    }
  }
}

# Private (container) subnet for Databricks worker nodes
resource "azurerm_subnet" "private" {
  count = var.create_new_vnet ? 1 : 0
  
  name                 = "${var.project_prefix}-private-subnet"
  resource_group_name  = azurerm_resource_group.this.name
  virtual_network_name = azurerm_virtual_network.this[0].name
  address_prefixes     = [var.{{first_private_subnet_var}}_subnet_cidr]
  
  # Required delegation for Databricks
  delegation {
    name = "databricks-del-private"
    
    service_delegation {
      name = "Microsoft.Databricks/workspaces"
      actions = [
        "Microsoft.Network/virtualNetworks/subnets/join/action",
        "Microsoft.Network/virtualNetworks/subnets/prepareNetworkPolicies/action",
        "Microsoft.Network/virtualNetworks/subnets/unprepareNetworkPolicies/action"
      ]
    }
  }
}

# Associate NSG with public subnet
resource "azurerm_subnet_network_security_group_association" "public" {
  count = var.create_new_vnet ? 1 : 0
  
  subnet_id                 = azurerm_subnet.public[0].id
  network_security_group_id = azurerm_network_security_group.databricks[0].id
}

# Associate NSG with private subnet
resource "azurerm_subnet_network_security_group_association" "private" {
  count = var.create_new_vnet ? 1 : 0
  
  subnet_id                 = azurerm_subnet.private[0].id
  network_security_group_id = azurerm_network_security_group.databricks[0].id
}

# ----------------------------------------------------------------------------
# DATABRICKS WORKSPACE
# ----------------------------------------------------------------------------

# Main Databricks workspace resource
resource "azurerm_databricks_workspace" "this" {
  name                = var.workspace_name
  resource_group_name = azurerm_resource_group.this.name
  location            = azurerm_resource_group.this.location
  sku                 = var.pricing_tier
  
  # Resource group for Azure-managed Databricks resources
  managed_resource_group_name = "${var.project_prefix}-databricks-managed-rg"
  
  # Custom VNet configuration (new or existing VNet)
  custom_parameters {
    virtual_network_id                                   = local.vnet_id
    public_subnet_name                                   = var.create_new_vnet ? azurerm_subnet.public[0].name : var.existing_public_subnet_name
    private_subnet_name                                  = var.create_new_vnet ? azurerm_subnet.private[0].name : var.existing_private_subnet_name
    public_subnet_network_security_group_association_id  = var.create_new_vnet ? azurerm_subnet_network_security_group_association.public[0].id : null
    private_subnet_network_security_group_association_id = var.create_new_vnet ? azurerm_subnet_network_security_group_association.private[0].id : null
    no_public_ip                                         = var.enable_private_link
  }
  
  tags = var.common_tags
  
  depends_on = [
    azurerm_subnet_network_security_group_association.public,
    azurerm_subnet_network_security_group_association.private
  ]
}
