# ============================================================================
# Azure Terraform Variables
# ============================================================================
#
# PURPOSE:
#   This file defines all input variables for the Azure Databricks deployment.
#
# USAGE:
#   - Set values in terraform.tfvars (recommended)
#   - Override via command line: terraform apply -var="region=eastus"
#   - Use environment variables: export TF_VAR_region=eastus
# ============================================================================

# ----------------------------------------------------------------------------
# BASIC CONFIGURATION
# ----------------------------------------------------------------------------

variable "region" {
  description = "Azure region for resource deployment"
  type        = string
  default     = "{{region}}"
}

variable "project_prefix" {
  description = "Prefix for all resource names"
  type        = string
  default     = "{{project_prefix}}"
}

variable "resource_group_name" {
  description = "Azure Resource Group name"
  type        = string
  default     = "{{resource_group_name}}"
}

# ----------------------------------------------------------------------------
# VPC CONFIGURATION
# ----------------------------------------------------------------------------

variable "vnet_cidr" {
  description = "CIDR block for the Virtual Network"
  type        = string
  default     = "{{vpc_cidr}}"
}

variable "create_new_vnet" {
  description = "Whether to create a new VNet (true) or use an existing one (false)"
  type        = bool
  default     = {{create_new_vpc}}
}

variable "existing_vnet_id" {
  description = "Resource ID of existing VNet (required when create_new_vnet is false)"
  type        = string
  default     = "{{existing_vnet_id}}"
}

variable "existing_public_subnet_name" {
  description = "Name of existing public (host) subnet with Databricks delegation"
  type        = string
  default     = "{{existing_public_subnet_name}}"
}

variable "existing_private_subnet_name" {
  description = "Name of existing private (container) subnet with Databricks delegation"
  type        = string
  default     = "{{existing_private_subnet_name}}"
}

# ----------------------------------------------------------------------------
# SUBNET CONFIGURATION
# ----------------------------------------------------------------------------
{{#each calculated_subnets}}
variable "{{name_replace}}_subnet_cidr" {
  description = "CIDR block for {{name}} subnet"
  type        = string
  default     = "{{cidr}}"
}

{{/each}}
# ----------------------------------------------------------------------------
# DATABRICKS CONFIGURATION
# ----------------------------------------------------------------------------

variable "pricing_tier" {
  description = "Databricks workspace pricing tier: standard, premium, or trial"
  type        = string
  default     = "{{pricing_tier_lower}}"
  
  validation {
    condition     = contains(["standard", "premium", "trial"], var.pricing_tier)
    error_message = "Pricing tier must be one of: standard, premium, or trial."
  }
}

variable "workspace_name" {
  description = "Name of the Databricks workspace"
  type        = string
  default     = "{{project_prefix}}"
}

# ----------------------------------------------------------------------------
# SECURITY CONFIGURATION
# ----------------------------------------------------------------------------

variable "enable_private_link" {
  description = "Enable Azure Private Link for private connectivity"
  type        = bool
  default     = {{enable_private_link}}
}

# ----------------------------------------------------------------------------
# TAGGING CONFIGURATION
# ----------------------------------------------------------------------------

variable "common_tags" {
  description = "Common tags to apply to all resources"
  type        = map(string)
  default = {
    Project     = "{{project_prefix}}"
    Environment = "dev"
    ManagedBy   = "terraform"
    Provider    = "azure"
    CreatedBy   = "oneclick-databricks-deployer"
  }
}
