# ============================================================================
# Terraform Version Constraints
# ============================================================================
#
# PURPOSE:
#   This file specifies which versions of Terraform and providers are required.
#
# ============================================================================

terraform {
  required_version = ">= 1.0"
  
  required_providers {
    # Azure Provider - manages Azure resources
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 3.0"
    }
    
    # Databricks Provider - manages Databricks resources
    databricks = {
      source  = "databricks/databricks"
      version = "~> 1.26"
    }
  }
}
