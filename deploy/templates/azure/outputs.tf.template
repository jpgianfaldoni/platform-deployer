# ============================================================================
# Azure Terraform Outputs
# ============================================================================
#
# PURPOSE:
#   This file defines output values displayed after Terraform applies.
#
# ============================================================================

# ----------------------------------------------------------------------------
# DATABRICKS WORKSPACE OUTPUTS
# ----------------------------------------------------------------------------

output "workspace_url" {
  description = "Databricks workspace URL"
  value       = "https://${azurerm_databricks_workspace.this.workspace_url}"
}

output "workspace_id" {
  description = "Databricks workspace ID"
  value       = azurerm_databricks_workspace.this.workspace_id
}

output "workspace_resource_id" {
  description = "Azure resource ID of the Databricks workspace"
  value       = azurerm_databricks_workspace.this.id
}

# ----------------------------------------------------------------------------
# RESOURCE GROUP OUTPUTS
# ----------------------------------------------------------------------------

output "resource_group_name" {
  description = "Name of the resource group"
  value       = azurerm_resource_group.this.name
}

output "resource_group_location" {
  description = "Location of the resource group"
  value       = azurerm_resource_group.this.location
}

# ----------------------------------------------------------------------------
# NETWORKING OUTPUTS
# ----------------------------------------------------------------------------

output "vnet_id" {
  description = "Virtual Network ID"
  value       = var.create_new_vnet ? azurerm_virtual_network.this[0].id : null
}

output "public_subnet_id" {
  description = "Public subnet ID"
  value       = var.create_new_vnet ? azurerm_subnet.public[0].id : null
}

output "private_subnet_id" {
  description = "Private subnet ID"
  value       = var.create_new_vnet ? azurerm_subnet.private[0].id : null
}
