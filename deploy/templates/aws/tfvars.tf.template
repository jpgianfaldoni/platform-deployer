# AWS Configuration
aws_region     = "{{region}}"
project_prefix = "{{project_prefix}}"

# VPC Configuration
vpc_cidr        = "{{vpc_cidr}}"
create_new_vpc  = {{create_new_vpc}}
{{#unless create_new_vpc}}{{#if existing_vpc_name}}existing_vpc_id = "{{existing_vpc_name}}"  # Update this with actual VPC ID
{{/if}}{{/unless}}
availability_zones = {{availability_zones}}

# Subnet CIDR blocks (calculated automatically)
{{#each calculated_subnets}}
{{name_replace}}_subnet_cidr = "{{cidr}}"
{{/each}}
# Databricks Configuration
# IMPORTANT: Set these values before running terraform apply
databricks_account_id = ""  # Your Databricks account ID (required)
pricing_tier          = "{{pricing_tier}}"
workspace_name        = "{{project_prefix}}-workspace"

# Security Configuration
enable_private_link = {{enable_private_link}}

{{#if cross_account_role_arn}}cross_account_role_arn = "{{cross_account_role_arn}}"
{{/if}}
# Advanced Configuration
enable_nat_gateway    = {{enable_nat_gateway}}
enable_vpc_endpoints  = true
enable_flow_logs      = true

# Resource Tags
common_tags = {{common_tags}}

# Additional tags will be automatically merged:
# - Project: {{project_prefix}}
# - Environment: dev
# - ManagedBy: terraform
# - Provider: aws
# - CreatedBy: databricks-deployer

