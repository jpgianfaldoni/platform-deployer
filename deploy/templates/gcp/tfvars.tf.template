# ============================================================================
# Terraform Variables File (terraform.tfvars)
# ============================================================================
#
# PURPOSE:
#   This file provides default values for all variables.
#
# ============================================================================

# ----------------------------------------------------------------------------
# BASIC CONFIGURATION
# ----------------------------------------------------------------------------

project_id     = "{{project_id}}"
region         = "{{region}}"
project_prefix = "{{project_prefix}}"

# ----------------------------------------------------------------------------
# VPC CONFIGURATION
# ----------------------------------------------------------------------------

vpc_cidr       = "{{vpc_cidr}}"
create_new_vpc = {{create_new_vpc}}
{{#unless create_new_vpc}}
# Existing VPC Configuration
existing_vpc_name            = "{{existing_vpc_name}}"
existing_subnet_name         = "{{existing_subnet_name}}"
existing_pod_range_name      = "{{existing_pod_range_name}}"
existing_service_range_name  = "{{existing_service_range_name}}"
{{/unless}}

# Subnet CIDRs
{{#each calculated_subnets}}
{{name_replace}}_subnet_cidr = "{{cidr}}"
{{/each}}

# GKE Pod and Service CIDRs
pods_cidr     = "10.1.0.0/16"
services_cidr = "10.2.0.0/20"

# ----------------------------------------------------------------------------
# DATABRICKS CONFIGURATION
# ----------------------------------------------------------------------------

# IMPORTANT: Uncomment and set your Databricks account ID (REQUIRED)
# Find it at: Databricks Account Console > Settings > Account ID
# You can also use environment variable: export TF_VAR_databricks_account_id="your-id"
# databricks_account_id = ""

pricing_tier   = "{{pricing_tier}}"
workspace_name = "{{project_prefix}}"

# ----------------------------------------------------------------------------
# SECURITY CONFIGURATION
# ----------------------------------------------------------------------------

enable_private_service_connect = {{enable_private_link}}

# ----------------------------------------------------------------------------
# LABELS
# ----------------------------------------------------------------------------

common_labels = {
  project     = "{{project_prefix}}"
  environment = "dev"
  managed-by  = "terraform"
  provider    = "gcp"
  created-by  = "oneclick-databricks-deployer"
}
