# ============================================================================
# Terraform Version Constraints
# ============================================================================
#
# PURPOSE:
#   This file specifies which versions of Terraform and providers are required.
#
# ============================================================================

terraform {
  required_version = ">= 1.0"
  
  required_providers {
    # Google Provider - manages GCP resources
    google = {
      source  = "hashicorp/google"
      version = "~> 5.0"
    }
    
    # Databricks Provider - manages Databricks resources
    databricks = {
      source  = "databricks/databricks"
      version = "~> 1.26"
    }
    
    # Random Provider - for generating unique names
    random = {
      source  = "hashicorp/random"
      version = "~> 3.0"
    }
  }
}
