# ============================================================================
# GCP Main Terraform Configuration
# ============================================================================
# Deploys Databricks workspace on GCP with VPC, subnets, and Cloud NAT.
# ============================================================================

# ----------------------------------------------------------------------------
# RANDOM SUFFIX
# ----------------------------------------------------------------------------

# Random suffix for globally unique resource names
resource "random_string" "suffix" {
  length  = 4
  special = false
  upper   = false
}

# ----------------------------------------------------------------------------
# VPC NETWORK
# ----------------------------------------------------------------------------

# VPC network for Databricks resources
resource "google_compute_network" "this" {
  count = var.create_new_vpc ? 1 : 0
  
  name                    = "${var.project_prefix}-vpc"
  auto_create_subnetworks = false
  project                 = var.project_id
}

locals {
  # VPC references (new or existing)
  vpc_id   = var.create_new_vpc ? google_compute_network.this[0].id : data.google_compute_network.existing[0].id
  vpc_name = var.create_new_vpc ? google_compute_network.this[0].name : var.existing_vpc_name
}

# Data source for existing VPC
data "google_compute_network" "existing" {
  count   = var.create_new_vpc ? 0 : 1
  name    = var.existing_vpc_name
  project = var.project_id
}

# ----------------------------------------------------------------------------
# SUBNET
# ----------------------------------------------------------------------------

# Primary subnet with secondary ranges for GKE pods and services
resource "google_compute_subnetwork" "primary" {
  count = var.create_new_vpc ? 1 : 0
  
  name                     = "${var.project_prefix}-primary-subnet"
  ip_cidr_range            = var.{{first_host_subnet_var}}_subnet_cidr
  region                   = var.region
  network                  = google_compute_network.this[0].id
  private_ip_google_access = true
  project                  = var.project_id
  
  # Secondary range for GKE pods
  secondary_ip_range {
    range_name    = "${var.project_prefix}-pods"
    ip_cidr_range = var.pods_cidr
  }
  
  # Secondary range for GKE services
  secondary_ip_range {
    range_name    = "${var.project_prefix}-services"
    ip_cidr_range = var.services_cidr
  }
}

# ----------------------------------------------------------------------------
# CLOUD ROUTER AND NAT
# ----------------------------------------------------------------------------

# Cloud Router for NAT gateway
resource "google_compute_router" "this" {
  count = var.create_new_vpc ? 1 : 0
  
  name    = "${var.project_prefix}-router"
  region  = var.region
  network = google_compute_network.this[0].id
  project = var.project_id
}

# Cloud NAT for outbound internet access
resource "google_compute_router_nat" "this" {
  count = var.create_new_vpc ? 1 : 0
  
  name                               = "${var.project_prefix}-nat"
  router                             = google_compute_router.this[0].name
  region                             = var.region
  nat_ip_allocate_option             = "AUTO_ONLY"
  source_subnetwork_ip_ranges_to_nat = "ALL_SUBNETWORKS_ALL_IP_RANGES"
  project                            = var.project_id
  
  log_config {
    enable = true
    filter = "ERRORS_ONLY"
  }
}

# ----------------------------------------------------------------------------
# DATABRICKS MWS CONFIGURATION
# ----------------------------------------------------------------------------

# Register VPC network with Databricks
resource "databricks_mws_networks" "this" {
  provider     = databricks.mws
  account_id   = var.databricks_account_id
  network_name = "${var.project_prefix}-network"

  # GCP-specific network configuration
  gcp_network_info {
    network_project_id    = var.project_id
    vpc_id                = local.vpc_name
    subnet_id             = var.create_new_vpc ? google_compute_subnetwork.primary[0].name : var.existing_subnet_name
    subnet_region         = var.region
    pod_ip_range_name     = var.create_new_vpc ? "${var.project_prefix}-pods" : var.existing_pod_range_name
    service_ip_range_name = var.create_new_vpc ? "${var.project_prefix}-services" : var.existing_service_range_name
  }
}

# ----------------------------------------------------------------------------
# DATABRICKS WORKSPACE
# ----------------------------------------------------------------------------

# Main Databricks workspace resource
resource "databricks_mws_workspaces" "this" {
  provider       = databricks.mws
  account_id     = var.databricks_account_id
  workspace_name = var.workspace_name
  location       = var.region
  
  # GCP project configuration
  cloud_resource_container {
    gcp {
      project_id = var.project_id
    }
  }
  
  network_id = databricks_mws_networks.this.network_id
  
  # GKE cluster configuration
  gke_config {
    connectivity_type = var.enable_private_service_connect ? "PRIVATE_NODE_PUBLIC_MASTER" : "PUBLIC_NODE_PUBLIC_MASTER"
    master_ip_range   = "10.3.0.0/28"
  }
  
  # Generate workspace token for API access
  token {
    comment = "Terraform provisioning token"
  }
  
  depends_on = [
    google_compute_router_nat.this
  ]
}
