# ============================================================================
# GCP Terraform Variables
# ============================================================================
#
# PURPOSE:
#   This file defines all input variables for the GCP Databricks deployment.
#
# USAGE:
#   - Set values in terraform.tfvars (recommended)
#   - Override via command line: terraform apply -var="region=us-central1"
#   - Use environment variables: export TF_VAR_region=us-central1
# ============================================================================

# ----------------------------------------------------------------------------
# BASIC CONFIGURATION
# ----------------------------------------------------------------------------

variable "project_id" {
  description = "GCP Project ID"
  type        = string
  default     = "{{project_id}}"
}

variable "region" {
  description = "GCP region for resource deployment"
  type        = string
  default     = "{{region}}"
}

variable "project_prefix" {
  description = "Prefix for all resource names"
  type        = string
  default     = "{{project_prefix}}"
}

# ----------------------------------------------------------------------------
# VPC CONFIGURATION
# ----------------------------------------------------------------------------

variable "vpc_cidr" {
  description = "CIDR block for the primary subnet"
  type        = string
  default     = "{{vpc_cidr}}"
}

variable "create_new_vpc" {
  description = "Whether to create a new VPC (true) or use an existing one (false)"
  type        = bool
  default     = {{create_new_vpc}}
}

variable "existing_vpc_name" {
  description = "Name of existing VPC network (required when create_new_vpc is false)"
  type        = string
  default     = "{{existing_vpc_name}}"
}

variable "existing_subnet_name" {
  description = "Name of existing subnet (required when create_new_vpc is false)"
  type        = string
  default     = "{{existing_subnet_name}}"
}

variable "existing_pod_range_name" {
  description = "Name of existing secondary IP range for GKE pods"
  type        = string
  default     = "{{existing_pod_range_name}}"
}

variable "existing_service_range_name" {
  description = "Name of existing secondary IP range for GKE services"
  type        = string
  default     = "{{existing_service_range_name}}"
}

# ----------------------------------------------------------------------------
# SUBNET CONFIGURATION
# ----------------------------------------------------------------------------
{{#each calculated_subnets}}
variable "{{name_replace}}_subnet_cidr" {
  description = "CIDR block for {{name}} subnet"
  type        = string
  default     = "{{cidr}}"
}

{{/each}}
# GKE Pod and Service CIDRs (required for Databricks on GCP)
variable "pods_cidr" {
  description = "CIDR block for GKE pods"
  type        = string
  default     = "10.1.0.0/16"
}

variable "services_cidr" {
  description = "CIDR block for GKE services"
  type        = string
  default     = "10.2.0.0/20"
}

# ----------------------------------------------------------------------------
# DATABRICKS CONFIGURATION
# ----------------------------------------------------------------------------

variable "databricks_account_id" {
  description = "Databricks account ID (found in Databricks account settings)"
  type        = string
  sensitive   = true
  
  validation {
    condition     = length(var.databricks_account_id) > 0
    error_message = "databricks_account_id is required. Find it at: Account Console > Settings > Account ID. You can also set it via environment variable: export TF_VAR_databricks_account_id=<your-account-id>"
  }
}

variable "pricing_tier" {
  description = "Databricks workspace pricing tier: STANDARD, PREMIUM, or ENTERPRISE"
  type        = string
  default     = "{{pricing_tier}}"
  
  validation {
    condition     = contains(["STANDARD", "PREMIUM", "ENTERPRISE"], var.pricing_tier)
    error_message = "Pricing tier must be one of: STANDARD, PREMIUM, or ENTERPRISE."
  }
}

variable "workspace_name" {
  description = "Name of the Databricks workspace"
  type        = string
  default     = "{{project_prefix}}"
}

# ----------------------------------------------------------------------------
# SECURITY CONFIGURATION
# ----------------------------------------------------------------------------

variable "enable_private_service_connect" {
  description = "Enable GCP Private Service Connect for private connectivity"
  type        = bool
  default     = {{enable_private_link}}
}

# ----------------------------------------------------------------------------
# TAGGING CONFIGURATION
# ----------------------------------------------------------------------------

variable "common_labels" {
  description = "Common labels to apply to all resources"
  type        = map(string)
  default = {
    project     = "{{project_prefix}}"
    environment = "dev"
    managed-by  = "terraform"
    provider    = "gcp"
    created-by  = "oneclick-databricks-deployer"
  }
}
