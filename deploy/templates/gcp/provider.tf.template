terraform {
  required_version = ">= 1.0"
  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 5.0"
    }
    databricks = {
      source  = "databricks/databricks"
      version = "~> 1.26"
    }
  }
}

provider "google" {
  project = var.project_id
  region  = var.region
}

provider "databricks" {
  host = "https://accounts.gcp.databricks.com"
}

